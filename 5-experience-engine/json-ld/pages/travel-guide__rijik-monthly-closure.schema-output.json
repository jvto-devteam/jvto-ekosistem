      },
      {
        "@id": "https://javavolcano-touroperator.com/travel-guide/rijik-monthly-closure#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Why does Kawah Ijen close on the first Friday of every month?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Since March 2019, TWA Ijen (the Ijen Nature Tourism Park) has closed to all visitors on the first Friday of every month for \"Rijik\" — a scheduled ecosystem-cleaning day. Park staff and volunteers descend into the crater area to remove trash left behind by tourism and mining traffic, typically collecting an estimated 100–150 kg of waste per session. It is a recurring conservation closure, not an emergency shutdown or a sign of a safety incident."
            }
          },
          {
            "@type": "Question",
            "name": "Will my JVTO tour ever be cancelled because of the Rijik closure day?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. JVTO checks the TWA Ijen closure calendar before confirming any Ijen-inclusive itinerary and schedules guest departures to avoid the first Friday of the month. If a guest's preferred travel window happens to land on a Rijik closure day, JVTO adjusts the itinerary order in advance — for example, visiting Bromo or Madakaripura first — so the closure never disrupts a confirmed booking."
            }
          },
          {
            "@type": "Question",
            "name": "Is the monthly Ijen closure the same as a PVMBG volcanic-activity closure?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No, they are separate and unrelated. Rijik is a fixed, scheduled cleaning day that occurs on the first Friday of every month regardless of volcanic conditions. A PVMBG (Indonesian volcanology agency) closure is unscheduled and happens only when gas emissions or seismic activity cross an official safety threshold. JVTO monitors both: the fixed Rijik calendar for routine scheduling, and real-time PVMBG alerts for safety-driven closures. See Weather & Closures for how PVMBG-driven changes are handled."
            }
          },
          {
            "@type": "Question",
            "name": "How much trash is removed during the Rijik cleanup at Ijen?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Volunteers and park staff typically remove an estimated 100–150 kg of trash from the Kawah Ijen crater area during each monthly Rijik session — waste accumulated from tourism and mining traffic since the previous cleanup."
            }
          },
          {
            "@type": "Question",
            "name": "When did the Ijen Rijik cleanup program start?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The program has run since March 2019, with TWA Ijen closing to visitors on the first Friday of every month for the cleanup. JVTO has scheduled guest itineraries around this fixed closure day for the same period."
            }
          }
        ]
      }
