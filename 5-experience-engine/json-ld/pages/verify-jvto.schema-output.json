        "mainEntity": [
          {
            "@type": "Question",
            "name": "What kinds of proof does JVTO publish before booking?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Four layers: (1) Legal — NIB/TDUP/AHU registration verifiable on Indonesian government registries; (2) Police — founder Bripka Agung Sambuko's SPRIN-POLPAR and SPRIN-WAL-TRAVEL assignment documents plus Detik.com identity confirmation; (3) Press & Recognition — the Stefan Loose editorial feature, the Booking.com 2015 award, and the Detik 2021 article; (4) History & Artifacts — operational continuity from the 2015 guesthouse era through the 2023 PT formalization."
            }
          },
          {
            "@type": "Question",
            "name": "Is Java Volcano Tour Operator a legal business in Indonesia?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. JVTO operates under PT Java Volcano Rendezvous with Business Identification Number (NIB) 1102230032918 and a TDUP tourism licence under the same identifier (issued 2023-02-11). Both are searchable on the Indonesian government OSS and AHU registries."
            }
          },
          {
            "@type": "Question",
            "name": "Does JVTO have official Police authority?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "JVTO was founded by an active Tourist Police officer (Ditpamobvit). Official coordination evidence is provided via SPRIN (assignment order) documents in the evidence locker, and the founder's role is independently confirmed by Detik.com's March 2021 article. JVTO is a private operator; the police reference describes the founder's professional background and does not imply government endorsement."
            }
          },
          {
            "@type": "Question",
            "name": "How can I verify the documents provided by JVTO?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Every document in the evidence locker includes a published SHA-256 hash. Download the original file, compute its SHA-256 locally, and compare it to the published value to detect tampering. Where a registry link is provided, follow it to cross-check the details on the official government portal."
            }
          },
          {
            "@type": "Question",
            "name": "Why publish proof at all instead of just describing the tours?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tour operators in Indonesia operate in a landscape where licensing claims are easy to make and hard to verify. JVTO publishes the actual government registry IDs and document scans so travellers can independently confirm every claim through third-party Indonesian data sources before paying any deposit."
            }
          }
        ]
