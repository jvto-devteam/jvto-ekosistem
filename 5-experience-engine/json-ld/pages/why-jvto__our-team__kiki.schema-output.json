        "review": [
          {
            "@type": "Review",
            "@id": "https://javavolcano-touroperator.com/why-jvto/reviews/81#crew-kiki",
            "url": "https://javavolcano-touroperator.com/why-jvto/reviews/81",
            "author": {
              "@type": "Person",
              "name": "Estera Herman"
            },
            "datePublished": "2026-06-28",
            "reviewBody": "I did the 3-Day Ijen, Bromo & Madakaripura Waterfall Discovery from Surabaya, and it was honestly one of the best experiences of my life!\n\nA huge thank you to our amazing tour guide Kiki and our driver Holili. They made the whole trip so easy, stress-free, and truly unforgettable. They were professional, friendly, and always made sure everything ran smoothly.\n\nEvery single stop was incredible, and the views were beyond anything I can describe. From the blue fire at Ijen to the sunrise over Bromo and the stunning Madakaripura Waterfall, every moment was absolutely perfect.\n\nI highly, highly recommend this tour to anyone visiting East Java. It was an experience I’ll never forget!",
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5",
              "bestRating": "5",
              "worstRating": "1"
            }
          },
          {
            "@type": "Review",
            "@id": "https://javavolcano-touroperator.com/why-jvto/reviews/97#crew-kiki",
            "url": "https://javavolcano-touroperator.com/why-jvto/reviews/97",
            "author": {
              "@type": "Person",
              "name": "Yu Qing Yan"
            },
            "datePublished": "2026-05-11",
            "reviewBody": "Just had an amazing time at Ijen, Tumpak Sewu, and Bromo with Mas Kiki- incredible guide, we got a lot of pictures at the best spots!!!! Everything doesn’t feel rushed, very structured too! Our group had the most amazing time with his friendliness, humour, and flexibility.\n\nWe had a little hiccup with our first driver and had to change to a different driver midway, but thruought the whole journey, the tour operator was very helpful and quick in responses. We really appreciate it!",
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5",
              "bestRating": "5",
              "worstRating": "1"
            }
          },
          {
            "@type": "Review",
