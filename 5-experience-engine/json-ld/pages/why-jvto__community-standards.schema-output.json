        "mainEntity": [
          {
            "@type": "Question",
            "name": "What partnerships does JVTO hold?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "JVTO is a registered ISIC provider (student identity card programme), an HPWKI member (Ijen crater operator association), and publicly listed in the INDECON ecotourism network. Details and proof links are on this page."
            }
          },
          {
            "@type": "Question",
            "name": "Is health screening on Ijen mandatory?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Health screening is mandatory and non-negotiable for Ijen night hike routes. The system checks SpO2, blood pressure, resting heart rate, and respiratory history. No valid health certificate means no access to the crater zone."
            }
          },
          {
            "@type": "Question",
            "name": "What is the cancellation policy in brief?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Cancelling the complete booking 48+ hours before Day 1 converts it to 100% Lifetime Package Credit — it never expires, is transferable once, and is not exchangeable for cash. Cancelling the complete booking within 48 hours of Day 1 forfeits it. The policy has explicit exceptions: if one or more travellers cancel while the tour continues, tiered cash refunds apply (100% at 48+ hours, 50% within 48 hours, 0% after Day 1), and verified destination force majeure allows a choice of Package Credit or a cash refund less non-recoverable vendor costs. Full policy: /policy/booking-payment-cancellation."
            }
          },
          {
            "@type": "Question",
            "name": "Does JVTO mix strangers into one vehicle?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. JVTO runs private tours only. Your vehicle and crew are allocated exclusively for your booking."
            }
          },
          {
            "@type": "Question",
            "name": "What does JVTO's ISIC provider listing mean for students?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "JVTO offers student-focused pricing on selected tours for verified ISIC cardholders. Details and eligibility are at /isic/student-package."
            }
          }
