        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How does a JVTO booking work?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Choose a tour, submit lead guest details at checkout, pay the required amount (deposit or full payment), then receive your Official E-Voucher / Invoice (PDF) as formal confirmation."
            }
          },
          {
            "@type": "Question",
            "name": "How much is the deposit?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Standard deposit is 20% of the total booking value."
            }
          },
          {
            "@type": "Question",
            "name": "When can full payment be required at checkout?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "If Day 1 is within 14 days, JVTO may require up to 100% full payment at checkout."
            }
          },
          {
            "@type": "Question",
            "name": "When is the balance due if I paid deposit?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "By card: no later than 5 days before Day 1. By bank transfer/Wise: no later than 3 days before Day 1. Cash (IDR) is only if approved in writing and settled at the JVTO office before departure."
            }
          },
          {
            "@type": "Question",
            "name": "What happens if I cancel 48 hours or more before Day 1?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Guest-initiated cancellations at ≥48 hours convert 100% of payments received into JVTO Package Credit (not cash refund)."
            }
          },
          {
            "@type": "Question",
            "name": "What happens if I cancel less than 48 hours before Day 1 or no-show?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Late cancellations/no-shows may be forfeited up to 100%, with no Package Credit or cash refund normally provided."
            }
          },
          {
            "@type": "Question",
            "name": "Where do I find the binding rules?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Use /policy/booking-payment-cancellation and your Official E-Voucher / Invoice (PDF). If anything differs, the voucher/policies take precedence."
            }
          }
        ]
      }
