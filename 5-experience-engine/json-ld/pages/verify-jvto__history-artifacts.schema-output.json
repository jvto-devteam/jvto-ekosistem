          {
            "@type": "Question",
            "name": "Why treat artifacts as part of trust?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Because continuity is verifiable where marketing is not. A physical Booking.com plaque from 2015, an editorial guidebook citation, a national press article, and a government PT registration all point to the same address and the same founder — an evidence trail a traveller can cross-check, not a claim they have to take on faith."
            }
          },
          {
            "@type": "Question",
            "name": "Does JVTO assert a specific incorporation year?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. JVTO's brand and operation date from 2015 (the guesthouse era), and the PT was formalized in 2023 — evidenced by the TDUP tourism licence issued 2023-02-11 and NIB 1102230032918. JVTO does not assert a separate PT incorporation date, because no authoritative incorporation document supports one."
            }
          },
