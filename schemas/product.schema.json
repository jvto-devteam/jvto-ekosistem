{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jvto.local/schemas/product.schema.json",
  "title": "Tour Product Contract",
  "type": "object",
  "required": [
    "id",
    "canonical_id",
    "name",
    "slug",
    "status",
    "version",
    "effectiveFrom",
    "effective_date",
    "pickup_coverage",
    "pricing",
    "deposit",
    "add_ons",
    "luggage_constraints",
    "health_requirements",
    "closure_plan_b",
    "cancellation_policy",
    "channel_availability"
  ],
  "properties": {
    "id": { "type": "string" },
    "canonical_id": { "type": "string" },
    "packageId": { "type": "string" },
    "slug": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "status": { "enum": ["draft", "active", "paused", "retired"] },
    "route": {
      "type": "array",
      "items": { "type": "string" }
    },
    "durationDays": { "type": "number" },
    "startLocations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "endLocations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inclusions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exclusions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pricingRuleRef": { "type": "string" },
    "depositRuleRef": { "type": "string" },
    "policyRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "effectiveFrom": { "type": "string", "format": "date" },
    "effective_date": { "type": "string", "format": "date" },
    "effective_date_basis": { "type": "string" },
    "pickup_coverage": { "type": "object" },
    "pricing": { "type": "object" },
    "deposit": { "type": "object" },
    "add_ons": { "type": "object" },
    "luggage_constraints": { "type": "object" },
    "health_requirements": { "type": "object" },
    "closure_plan_b": { "type": "object" },
    "cancellation_policy": { "type": "object" },
    "channel_availability": { "type": "object" },
    "contract_refs": { "type": "object" }
  },
  "additionalProperties": true
}
